# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Prisma Database URL (Required for Prisma)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public

# JWT Configuration
JWT_SECRET=fleet-management-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
FRONTEND_URL=https://connectis.my.id
API_BASE_URL=https://be-tpms.connectis.my.id
ALLOWED_ORIGINS=https://connectis.my.id,https://be-tpms.connectis.my.id,http://localhost:5173,http://localhost:3000

# Logging Configuration
LOG_LEVEL=info
ADMIN_LOG_FILE=log/admin-activity.log

# WebSocket Configuration
WS_PATH=/ws
WS_PING_INTERVAL=30000